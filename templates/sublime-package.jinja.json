{
  "contributions": {
    "settings": [
      {
        "file_patterns": [
          "/LSP-oxfmt.sublime-settings"
        ],
        "schema": {
          "$id": "sublime://settings/LSP-oxfmt",
          "definitions": {
            "PluginConfig": {
              "properties": {
                "settings": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {{ settings | indent(18) }}
                },
                "server_path": {
                  "type": "string",
                  "default": "auto",
                  "markdownDescription": "The path to the `oxfmt` binary used to start the language server. Use `auto` to use the project's `node_modules/oxfmt` if present and otherwise the version managed by this package. A relative path is resolved against the workspace folder."
                }
              }
            }
          },
          "type": "object",
          "allOf": [
            {
              "$ref": "sublime://settings/LSP-plugin-base"
            },
            {
              "$ref": "sublime://settings/LSP-oxfmt#/definitions/PluginConfig"
            }
          ]
        }
      },
      {
        "file_patterns": [
          "/*.sublime-project"
        ],
        "schema": {
          "properties": {
            "settings": {
              "properties": {
                "LSP": {
                  "properties": {
                    "LSP-oxfmt": {
                      "$ref": "sublime://settings/LSP-oxfmt#/definitions/PluginConfig"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
